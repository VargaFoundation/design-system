{
  "$description": "Jetons du design system de la Varga Foundation — source de vérité unique. css/tokens.css est généré depuis ce fichier par scripts/build-tokens.mjs ; ne pas l'éditer à la main. Format : W3C Design Tokens Community Group.",
  "color": {
    "$type": "color",
    "base": {
      "paper": {
        "$value": "#FFFFFF",
        "$description": "Le fond. Blanc pur, sans teinte."
      },
      "ink": {
        "$value": "#0A0A0A",
        "$description": "Le texte et les pleins. Pas un noir absolu : #0A0A0A garde une trace de papier imprimé."
      },
      "brand": {
        "$value": "#29F7FF",
        "$description": "Le cyan du logo. Relevé au pixel sur varga.foundation. Illisible en texte sur blanc (1,33:1) : il ne sert qu'à la marque et aux aplats."
      },
      "brand-deep": {
        "$value": "#003336",
        "$description": "L'équerre et le mot FOUNDATION du logo. 13,75:1 sur blanc."
      },
      "accent": {
        "$value": "#00D5BE",
        "$description": "Le turquoise d'action du site (le bouton « J'accepte »). En aplat, avec du texte encre dessus (10,6:1) ; jamais en texte sur blanc (1,86:1)."
      }
    },
    "neutral": {
      "50": {
        "$value": "#FAFAFA"
      },
      "100": {
        "$value": "#F5F5F5"
      },
      "200": {
        "$value": "#E5E5E5"
      },
      "300": {
        "$value": "#D4D4D4"
      },
      "400": {
        "$value": "#A3A3A3"
      },
      "500": {
        "$value": "#737373"
      },
      "600": {
        "$value": "#525252"
      },
      "700": {
        "$value": "#404040"
      },
      "800": {
        "$value": "#262626"
      },
      "900": {
        "$value": "#171717"
      },
      "950": {
        "$value": "#0A0A0A"
      }
    },
    "status": {
      "ok": {
        "$value": "#15803D",
        "$description": "Assez sombre pour tenir le contraste AA sur blanc."
      },
      "warn": {
        "$value": "#B45309"
      },
      "danger": {
        "$value": "#DC2626"
      }
    }
  },
  "semantic": {
    "$description": "Ce que les composants consomment. Chaque rôle a une valeur claire et une valeur sombre. `accent` est un aplat (texte `accent-ink` dessus) ; `accent-strong` est la variante lisible en texte — #00796B, 5,32:1 sur blanc, parce que le turquoise de marque ne passe pas (1,86:1). `ink-subtle` (2,5:1 sur blanc) ne porte jamais un texte qui dit quelque chose : il sert aux éléments décoratifs et désactivés. Les libellés prennent `ink-muted` (7,8:1), les placeholders `ink-placeholder` (4,7:1).",
    "light": {
      "surface": "{color.base.paper}",
      "surface-muted": "{color.neutral.50}",
      "surface-sunken": "{color.neutral.100}",
      "line": "{color.neutral.200}",
      "line-strong": "{color.neutral.300}",
      "ink": "{color.base.ink}",
      "ink-muted": "{color.neutral.600}",
      "ink-subtle": "{color.neutral.400}",
      "inverse": "{color.base.ink}",
      "inverse-ink": "{color.base.paper}",
      "inverse-hover": "{color.neutral.800}",
      "ok": "{color.status.ok}",
      "warn": "{color.status.warn}",
      "danger": "{color.status.danger}",
      "accent": "{color.base.accent}",
      "accent-hover": "#00BFA9",
      "accent-ink": "{color.base.ink}",
      "accent-strong": "#00796B",
      "accent-soft": "#E5FBF8",
      "brand": "{color.base.brand}",
      "mark-frame": "{color.base.brand-deep}",
      "grid": "{color.neutral.100}",
      "focus": "#00796B",
      "ink-placeholder": "{color.neutral.500}"
    },
    "dark": {
      "surface": "{color.neutral.950}",
      "surface-muted": "{color.neutral.900}",
      "surface-sunken": "#050505",
      "line": "{color.neutral.800}",
      "line-strong": "{color.neutral.700}",
      "ink": "{color.neutral.50}",
      "ink-muted": "{color.neutral.400}",
      "ink-subtle": "{color.neutral.600}",
      "inverse": "{color.neutral.50}",
      "inverse-ink": "{color.base.ink}",
      "inverse-hover": "{color.neutral.200}",
      "ok": "#4ADE80",
      "warn": "#FBBF24",
      "danger": "#F87171",
      "accent": "{color.base.accent}",
      "accent-hover": "#3DDFCB",
      "accent-ink": "{color.base.ink}",
      "accent-strong": "{color.base.accent}",
      "accent-soft": "#00302B",
      "brand": "{color.base.brand}",
      "mark-frame": "{color.neutral.50}",
      "grid": "#141414",
      "focus": "{color.base.accent}",
      "ink-placeholder": "{color.neutral.400}"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "text": {
        "$value": [
          "JetBrains Mono",
          "Space Mono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ],
        "$description": "Tout le texte courant. La fondation écrit en monospace, comme on écrit du code."
      },
      "display": {
        "$value": [
          "Space Mono",
          "JetBrains Mono",
          "ui-monospace",
          "monospace"
        ],
        "$description": "Titres et chiffres mis en avant."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "light": {
        "$value": 300
      },
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": "0.75rem"
      },
      "sm": {
        "$value": "0.875rem"
      },
      "base": {
        "$value": "1rem"
      },
      "lg": {
        "$value": "1.125rem"
      },
      "xl": {
        "$value": "1.25rem"
      },
      "2xl": {
        "$value": "1.5rem"
      },
      "3xl": {
        "$value": "1.875rem"
      },
      "4xl": {
        "$value": "2.25rem"
      },
      "5xl": {
        "$value": "3rem"
      },
      "6xl": {
        "$value": "3.75rem"
      },
      "7xl": {
        "$value": "4.5rem"
      }
    },
    "leading": {
      "$type": "number",
      "tight": {
        "$value": 1
      },
      "snug": {
        "$value": 1.2
      },
      "body": {
        "$value": 1.4,
        "$description": "Celle du site : serrée pour du monospace, qui respire déjà par lui-même."
      }
    },
    "tracking": {
      "$type": "dimension",
      "body": {
        "$value": "-0.01em"
      },
      "display": {
        "$value": "-0.02em"
      },
      "label": {
        "$value": "0.06em",
        "$description": "Petites capitales des étiquettes et des en-têtes de tableau."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "none": {
      "$value": "0",
      "$description": "Aucun arrondi, nulle part. C'est la moitié de l'identité."
    }
  },
  "border": {
    "$type": "dimension",
    "hairline": {
      "$value": "1px"
    },
    "strong": {
      "$value": "2px",
      "$description": "Onglet actif, focus."
    }
  },
  "space": {
    "$type": "dimension",
    "section": {
      "$value": "4rem"
    },
    "section-lg": {
      "$value": "6rem"
    },
    "container": {
      "$value": "1.5rem"
    },
    "container-max": {
      "$value": "72rem"
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "120ms"
      },
      "base": {
        "$value": "200ms"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.4,
          0,
          0.2,
          1
        ]
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "hover": {
      "$value": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
      "$description": "La seule ombre du système : un soulèvement d'un pixel au survol."
    }
  }
}
